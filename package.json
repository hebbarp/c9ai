{
  "name": "c9ai",
  "version": "4.0.0",
  "description": "Local-first AI CLI — TUI shell, autonomous agent, autoresearch, Small Language Foundry, multi-provider (Claude / Gemini / Ollama / OpenAI-compatible)",
  "type": "module",
  "bin": {
    "c9ai": "dist/index.js"
  },
  "files": [
    "dist",
    "docs/create-your-models.md",
    "samples",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.tsx",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clean": "rimraf dist",
    "prepublishOnly": "npm run clean && npm run build",
    "release:alpha": "npm publish --tag alpha --access public",
    "release:latest": "npm publish --access public",
    "pampa:audit": "node scripts/pampa-corpus-audit.mjs",
    "pampa:extract": "node scripts/pampa-corpus-extract.mjs",
    "pampa:annotate": "python scripts/pampa_annotate.py",
    "pampa:prepare": "python scripts/pampa_prepare_training_corpus.py",
    "pampa:tokenizer-bench": "python scripts/pampa_tokenizer_bench.py",
    "pampa:train-tiny": "python scripts/pampa_train_tiny_lm.py"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.91.1",
    "cfonts": "^3.3.1",
    "dotenv": "^17.4.2",
    "ink": "^5.0.1",
    "ink-big-text": "^2.0.0",
    "ink-text-input": "^6.0.0",
    "meow": "^13.2.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "rimraf": "^5.0.10",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ai",
    "cli",
    "tui",
    "ink",
    "agent",
    "claude",
    "gemini",
    "ollama",
    "anthropic",
    "llm",
    "local-first"
  ],
  "author": {
    "name": "Prashanth Hebbar",
    "email": "prashanth@knobly.com",
    "url": "https://knobly.com"
  },
  "homepage": "https://github.com/hebbarp/c9ai#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hebbarp/c9ai.git"
  },
  "bugs": {
    "url": "https://github.com/hebbarp/c9ai/issues"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  }
}
