# AI API Keys
ANTHROPIC_API_KEY=your_claude_api_key_here
GOOGLE_AI_API_KEY=your_gemini_api_key_here

# Web Search API (optional - for web.search tool)
SERPAPI_KEY=your_serpapi_key_here

# Local LLM Provider Configuration
LOCAL_PROVIDER=llamacpp
# Options: llamacpp, ollama, node-llama-cpp

# Llama.cpp Server (if using llamacpp provider)
LLAMACPP_BASE_URL=http://127.0.0.1:8080
LLAMACPP_MODEL=llama-3.1-8b-instruct-q4
LLAMACPP_HOST=127.0.0.1
LLAMACPP_PORT=8080
LLAMACPP_AUTO_START=true

# Ollama (if using ollama provider)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b-instruct-q4_0

# Email Configuration for Notifications
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_app_password

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-here