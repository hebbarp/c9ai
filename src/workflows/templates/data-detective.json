    },
    {
      "step": "data-cleaning",
      "description": "Clean and prepare data for analysis",
      "tools": [
        "pandas.clean",
        "openrefine.process",
        "sql.transform"
      ],
      "vibe": "systematic",
      "estimatedTime": "45-60min"
    },
    {
      "step": "exploratory-analysis",
      "description": "Discover patterns and relationships",
      "tools": [
