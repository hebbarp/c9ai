# AI API Keys
ANTHROPIC_API_KEY=your_claude_api_key_here
GOOGLE_AI_API_KEY=your_gemini_api_key_here

# Web Search API
SERPAPI_KEY=681ae2cb2b9e511635de1cd3ee6d0f8032e4b705d8ef748ca2e18bacd4264bbb

# Local LLM Provider Configuration
LOCAL_PROVIDER=llamacpp
# Options: llamacpp, ollama, node-llama-cpp

# Llama.cpp Server (if using llamacpp provider)
LLAMACPP_BASE_URL=http://127.0.0.1:8080
LLAMACPP_MODEL=auto
LLAMACPP_HOST=127.0.0.1
LLAMACPP_PORT=8080
LLAMACPP_AUTO_START=false

# Email Configuration for Notifications
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=your_email@gmail.com
SENDER_PASSWORD=your_app_password

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=your-secret-key-here