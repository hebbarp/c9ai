        "matplotlib.plot",
        "seaborn.viz"
      ],
      "vibe": "explore",
      "estimatedTime": "60-90min"
    },
    {
      "step": "insight-synthesis",
      "description": "Transform findings into actionable insights",
      "tools": [
        "ai.summarize",
        "report.generate",
        "presentation.create"
      ],
